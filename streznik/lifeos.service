[Unit]
Description=Life OS (osebna aplikacija + planer za tablico)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/lifeos/streznik.py
Environment=LIFEOS_PORT=8090
DynamicUser=yes
StateDirectory=lifeos
StateDirectoryMode=0750
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=200M

[Install]
WantedBy=multi-user.target
